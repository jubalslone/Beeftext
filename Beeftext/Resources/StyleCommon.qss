/*****************************************************************************
 * Shared custom-theme details.
 *
 * Standard controls intentionally keep their platform style. In particular,
 * do not replace focus indicators, checkbox/radio indicators, combo arrows,
 * spin buttons, fonts, or control heights here.
 *****************************************************************************/

QPlainTextEdit {
    font-family: "Consolas";
}

QHeaderView::section,
QMenu::item:default {
    font-weight: 600;
}

QProgressBar {
    text-align: center;
}

#frameTopLevel {
    border-radius: 8px;
}

#ShortcutDialog #labelError {
    color: #258fc0;
    font-weight: 600;
}
