/*****************************************************************************
 * Light theme.
 *
 * Application colors are supplied through QPalette in Theme.cpp so standard
 * widgets retain native Windows/Qt metrics, state indicators, and focus cues.
 * Only the frameless combo picker needs explicit framing here.
 *****************************************************************************/

#frameTopLevel {
    border: 1px solid #8a8a8a;
    background-color: #ffffff;
}

#editSearch,
#listViewResults {
    border: 1px solid #8a8a8a;
    background-color: #ffffff;
}

#labelLogo {
    background-color: transparent;
}
